{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessments.schema.json",
  "title": "採点・種類別難易度（AI提出）。工数・総合難易度・合計は含めない（スクリプトが算出）",
  "type": "object",
  "required": [
    "schema_version",
    "case_assessments",
    "common_assessments"
  ],
  "additionalProperties": false,
  "$defs": {
    "axis": {
      "type": "object",
      "required": [
        "score",
        "condition",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "enum": [
            1,
            2,
            3,
            null
          ]
        },
        "condition": {
          "type": "string",
          "description": "適用した基準の条件（基準の文言・セル）"
        },
        "evidence": {
          "type": "string",
          "description": "原資料の根拠"
        },
        "standard_refs": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/std_ref"
          }
        },
        "assumptions": {
          "$ref": "defs.schema.json#/$defs/text_list"
        },
        "overlap_note": {
          "type": "string",
          "description": "使う共通部品（DATA・FIX・FLOW等）が所有する作業と重ならない、ケース固有に残る作業。部品と同じ作業を軸で再加点しない"
        },
        "operation_screens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "操作手順の軸で、ケースが自分で操作を行う画面（PAGEの構成要素ID）。判定だけの遷移先と、FLOW・AUTH・DATAに委ねた操作は含めない"
        },
        "factors": {
          "type": "array",
          "items": {
            "enum": [
              "branch",
              "dialog",
              "file"
            ]
          },
          "uniqueItems": true,
          "description": "操作手順の軸で2点の要因になる条件分岐・ダイアログ・ファイル操作"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "arch_ids",
          "scope",
          "scope_reason",
          "feasibility",
          "info_sufficient",
          "axes",
          "estimate_status",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string"
          },
          "arch_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scope": {
            "$ref": "defs.schema.json#/$defs/scope"
          },
          "scope_reason": {
            "type": "string"
          },
          "feasibility": {
            "enum": [
              "feasible",
              "impossible_confirmed",
              "unknown"
            ]
          },
          "impossible_reason": {
            "type": "string"
          },
          "info_sufficient": {
            "type": "boolean",
            "description": "主要情報が揃い方針を定められるか"
          },
          "axes": {
            "type": "object",
            "propertyNames": {
              "pattern": "^AX-[0-9]{2}$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/axis"
            }
          },
          "estimate_status": {
            "$ref": "defs.schema.json#/$defs/estimate_status"
          },
          "conditions": {
            "$ref": "defs.schema.json#/$defs/text_list"
          },
          "rationale": {
            "type": "string"
          },
          "uses_components": {
            "$ref": "defs.schema.json#/$defs/id_list"
          },
          "question_ids": {
            "$ref": "defs.schema.json#/$defs/id_list"
          }
        }
      }
    },
    "common_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "difficulty",
          "matched_conditions",
          "rationale",
          "estimate_status"
        ],
        "additionalProperties": false,
        "properties": {
          "component_id": {
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "Low",
              "Mid",
              "High",
              "Impossible",
              null
            ],
            "description": "Impossibleは合意範囲で実現不可と確認済の場合のみ（工数null）"
          },
          "matched_conditions": {
            "type": "string"
          },
          "standard_refs": {
            "type": "array",
            "items": {
              "$ref": "defs.schema.json#/$defs/std_ref"
            }
          },
          "rationale": {
            "type": "string"
          },
          "estimate_status": {
            "$ref": "defs.schema.json#/$defs/estimate_status"
          },
          "question_ids": {
            "$ref": "defs.schema.json#/$defs/id_list"
          },
          "impossible_reason": {
            "type": "string",
            "description": "Impossibleの理由・根拠・解消条件・代替案"
          },
          "conditions": {
            "$ref": "defs.schema.json#/$defs/text_list",
            "description": "条件付きの仮定・影響・再見積条件"
          },
          "screen_profiles": {
            "type": "array",
            "description": "PAGEの画面（構成要素）ごとの特徴。共通基準 BOUND-19 の難易度判定に使う事実だけを書く",
            "items": {
              "type": "object",
              "required": [
                "element",
                "inputs",
                "dynamic_list",
                "dialog",
                "file",
                "complex_ui"
              ],
              "additionalProperties": false,
              "properties": {
                "element": {
                  "type": "string",
                  "description": "PAGEの構成要素ID（elements と同じ）"
                },
                "inputs": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "ケース・共通部品がこの画面で操作する入力・選択項目の数（項目書と入力値定義から数える）"
                },
                "dynamic_list": {
                  "type": "boolean",
                  "description": "件数・内容が変わる一覧や検索結果を扱う"
                },
                "dialog": {
                  "type": "boolean",
                  "description": "モーダル・確認ダイアログを扱う"
                },
                "file": {
                  "type": "boolean",
                  "description": "ファイルのアップロード・ダウンロードを扱う"
                },
                "complex_ui": {
                  "type": "boolean",
                  "description": "iframe・ドラッグ・仮想スクロール等の複雑な動的UIを扱う"
                }
              }
            }
          }
        }
      }
    }
  }
}
