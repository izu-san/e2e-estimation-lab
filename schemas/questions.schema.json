{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questions.schema.json",
  "title": "確認事項・仮定・不可理由（AI提出）",
  "type": "object",
  "required": ["schema_version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "kind", "targets", "text", "impact", "status"],
        "additionalProperties": false,
        "properties": {
          "question_id": {"$ref": "defs.schema.json#/$defs/id"},
          "kind": {"enum": ["question", "assumption", "impossible_reason", "constraint", "standards_issue"]},
          "targets": {"description": "関係するcase_id/component_id/item_id/region_id", "type": "array", "items": {"type": "string"}},
          "refs": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/ref"}},
          "text": {"type": "string", "minLength": 1},
          "impact": {"type": "string"},
          "proposed_default": {"type": "string"},
          "status": {"enum": ["open", "assumed", "resolved"]}
        }
      }
    },
    "premise_reviews": {
      "description": "説明・参考領域（資料情報・前提・未確定事項）の行のうち、質問・仮定にしなかった行と理由。質問にした行は質問の refs に入れる",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "reason"],
        "additionalProperties": false,
        "properties": {
          "ref": {"$ref": "defs.schema.json#/$defs/ref"},
          "reason": {"type": "string", "minLength": 1, "description": "見積もりへの影響がない、または設定・共通設計に反映済みである理由"}
        }
      }
    }
  }
}
