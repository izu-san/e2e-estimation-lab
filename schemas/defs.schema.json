{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.schema.json",
  "title": "共通定義",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "maxLength": 80},
    "ref": {
      "type": "object",
      "description": "原資料の位置。rangeは A1 または A1:C5 形式",
      "required": ["workbook_id", "sheet", "range"],
      "additionalProperties": false,
      "properties": {
        "workbook_id": {"type": "string"},
        "sheet": {"type": "string"},
        "range": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]+(:[A-Z]{1,3}[0-9]+)?$"}
      }
    },
    "std_ref": {
      "type": "string",
      "description": "基準Excelの参照。cases:シート名!A1 / common:シート名!A1:B2",
      "pattern": "^(cases|common):.+![A-Z]{1,3}[0-9]+(:[A-Z]{1,3}[0-9]+)?$"
    },
    "estimate_status": {"enum": ["確定可能", "条件付き", "要確認"]},
    "scope": {"enum": ["対象内", "別見積", "対象外"]},
    "difficulty": {"enum": ["Low", "Mid", "High", null]},
    "text": {"type": "string"},
    "text_list": {"type": "array", "items": {"type": "string"}},
    "id_list": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
  }
}
